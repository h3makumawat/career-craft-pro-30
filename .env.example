# CareerCraft AI — environment template. Copy to .env and fill in real values.
# NEVER commit a real .env file.

# ---- Server-side only (never exposed to the browser) ----
# API key for the LLM gateway used by the backend AI service.
LOVABLE_API_KEY=your-llm-api-key-here

# Optional: explicit CORS allow-origin for the API routes.
# Leave empty when the frontend is served from the same origin (default).
CORS_ALLOW_ORIGIN=

# Optional: HTTP port for the production server container.
PORT=3000

# ---- Client-side (safe, public) ----
# Base URL of the backend API. Leave EMPTY for same-origin (recommended).
# Set only when the frontend is hosted separately, e.g. https://api.example.com
VITE_API_BASE_URL=
